# MechDost reverse proxy (docs/runbooks/deploy.md). Caddy gets and renews HTTPS certificates automatically once
# the DNS records point at this server. Security headers come from the apps themselves (next.config.ts, API).
{
	email {$ACME_EMAIL:admin@mechdost.com}
}

# Visitor log (decision 2026-11-24, docs/runbooks/traffic.md): one JSON line per request in a size-capped, rotated
# file. LOGGING ONLY: it never blocks, slows or changes a response. What it keeps out:
#   - the query string (reset links carry ?oobCode=..., share links carry tokens): everything after "?" becomes
#     "?REDACTED", in the request URI and in the Referer header; partner invite tokens in the path
#     (/partners/invite/<token>, /v1/partner-invites/<token>) become REDACTED too (security review 2026-11-24);
#   - Authorization, Cookie, Set-Cookie and Proxy-Authorization headers: Caddy logs these as REDACTED by default
#     (https://caddyserver.com/docs/caddyfile/directives/log; only the global option log_credentials turns that off,
#     and it is not set here);
#   - TLS details and response headers (noise, and Set-Cookie).
# Disk: at most 6 files of 16 MiB (the current one plus 5 rolled) = 96 MiB, rolled files older than 30 days go.
(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 16MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			# Query strings (reset codes, tokens) and path-embedded secrets (partner invite tokens: /partners/invite/<token>,
			# /hi/partners/invite/<token>, /v1/partner-invites/<token>) and the Ustaad garage-owner link
			# (/ustaad-attest/<token>, /v1/ustaad-attest/<token>, 2026-11-26) and the share teaser (/ustaad/s/<token>,
			# /v1/ustaad/s/<token>, 2026-11-26) never reach the log.
			request>uri regexp (/partners/invite/|/partner-invites/|/ustaad-attest/|/ustaad/s/|\?)[^?]* ${1}REDACTED
			request>headers>Referer regexp (/partners/invite/|/partner-invites/|/ustaad-attest/|/ustaad/s/|\?)[^?]* ${1}REDACTED
			request>tls delete
			resp_headers delete
		}
	}
}

mechdost.com {
	import access_log
	encode zstd gzip
	reverse_proxy web:3000
}

www.mechdost.com {
	redir https://mechdost.com{uri} permanent
}

api.mechdost.com {
	import access_log
	encode zstd gzip
	reverse_proxy api:4000
}
