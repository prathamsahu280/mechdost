# /opt/mechdost/.env on the server (mode 600). Copy the values from your local .env; never commit the real file.
# The website reads no secrets at run time (its public settings are build arguments in GitHub Actions).
# Web push (spec 10): the browser keys NEXT_PUBLIC_FIREBASE_VAPID_KEY and NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID are
# public repository variables passed as build arguments (docs/runbooks/push.md); the worker sends with the same
# service-account file as the live updates, so there is nothing to add here.
# Start the API container too, only once every "required" value below is filled in:
# COMPOSE_PROFILES=api
NODE_ENV=production
# IMAGE_TAG=<commit> is added and kept up to date by every deploy; do not edit it by hand.
APP_URL=https://mechdost.com
API_URL=https://api.mechdost.com
WEB_BASE_URL=https://mechdost.com
CORS_ORIGINS=https://mechdost.com
API_DOCS=off
DEFAULT_CITY_CODE=RPR

# Supabase (database stays on Supabase)
DATABASE_URL=
DATABASE_POOL_URL=
DATABASE_POOL_MAX=10
# DATABASE_CA_CERT is set by compose.yml (Supabase Root 2021 CA, deploy/supabase-ca-2021.crt).
# Job photos: the API stores before/after photos in the private bucket service-photos (created on start; runbook photos.md).
# Without both values uploads answer 503; the secret key stays on the server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_KEY_ID=
DATA_INDEX_KEY=

# Firebase: the real project id and its web API key. No service-account key file on the server.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
LIVE_TRANSPORT=polling

# Required by the API in production (it refuses to start without them):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=

# Optional services (leave empty until set up)
RESEND_API_KEY=
EMAIL_DOMAIN=mechdost.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Pre-launch testing only: lets production start with rzp_test_ keys (fake payments). Remove before real customers.
RAZORPAY_ALLOW_TEST_KEYS=
WHATSAPP_ENABLED=off
# Monitoring (decision 2026-11-14; docs/runbooks/monitoring.md). Empty = off; the API starts either way.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Admin → Errors (read-only Internal Integration token; never the CI upload token).
SENTRY_API_TOKEN=
SENTRY_ORG=mechdost
SENTRY_PROJECT_WEB=mechdost-api
SENTRY_PROJECT_API=mechdost-api-actual
SENTRY_REGION_URL=https://de.sentry.io
# PostHog EU cloud (the worker forwards consented events).
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ANTHROPIC_API_KEY=
