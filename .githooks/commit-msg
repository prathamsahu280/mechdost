#!/bin/sh
# CLAUDE.md hard rule 12: no AI attribution in commit messages (also catches `git commit -F` and editor messages,
# which the Claude Code commit-guard hook cannot see). Enable once per clone: git config core.hooksPath .githooks
if grep -qiE 'co-authored-by:|generated with.*claude' "$1"; then
  echo "commit-msg: AI attribution lines are not allowed in commits (CLAUDE.md hard rule 12). Remove them." >&2
  exit 1
fi
exit 0
