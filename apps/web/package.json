{
  "name": "@mechdost/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-map-worker.mjs && next dev --port 3000",
    "build": "node scripts/copy-map-worker.mjs && next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc -p tsconfig.json",
