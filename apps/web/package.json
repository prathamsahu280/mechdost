    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@firebase/app": "0.16.5",
    "@firebase/auth": "1.13.9",
    "@firebase/database": "1.1.5",
    "@firebase/messaging": "0.13.3",
    "@mechdost/shared": "workspace:*",
    "@mechdost/ui": "workspace:*",
    "@sentry/browser": "10.78.0",
    "@sentry/node": "10.78.0",
    "lucide-react": "1.63.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sentry/cli": "2.58.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
