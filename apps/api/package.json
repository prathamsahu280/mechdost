{
  "name": "@mechdost/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node dist/worker.mjs",
    "wa:templates": "tsx --env-file-if-exists=../../.env src/wa-templates.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@hono/node-server": "2.1.8",
    "@hono/zod-openapi": "1.6.3",
    "@mechdost/db": "workspace:*",
    "@mechdost/shared": "workspace:*",
    "@sentry/node": "10.78.0",
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.0",
    "firebase-admin": "14.5.1",
    "hono": "4.13.18",
    "pdfkit": "0.20.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pdfkit": "0.17.7",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
