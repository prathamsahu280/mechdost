{
  "name": "@mechdost/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node dist/worker.mjs",
    "wa:templates": "tsx --env-file-if-exists=../../.env src/wa-templates.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "import:catalogue": "tsx --env-file-if-exists=../../.env src/cli/import-catalogue.ts",
    "usage:check": "tsx --env-file-if-exists=../../.env src/cli/usage-check.ts",
    "import:exide": "tsx --env-file-if-exists=../../.env src/cli/import-exide.ts",
    "import:amaron": "tsx --env-file-if-exists=../../.env src/cli/import-amaron.ts",
    "import:tatagreen": "tsx --env-file-if-exists=../../.env src/cli/import-tatagreen.ts",
    "import:ceat": "tsx --env-file-if-exists=../../.env src/cli/import-ceat.ts",
    "import:mrf": "tsx --env-file-if-exists=../../.env src/cli/import-mrf.ts",
    "import:apollo": "tsx --env-file-if-exists=../../.env src/cli/import-apollo.ts",
    "import:hp": "tsx --env-file-if-exists=../../.env src/cli/import-hp.ts",
    "import:bpcl": "tsx --env-file-if-exists=../../.env src/cli/import-bpcl.ts",
    "import:servo": "tsx --env-file-if-exists=../../.env src/cli/import-servo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@mechdost/db": "workspace:*",
    "@mechdost/shared": "workspace:*",
    "@sentry/node": "11.18.0",
    "@upstash/redis": "1.40.0",
    "firebase-admin": "14.5.0",
    "hono": "4.13.16",
    "maxmind": "5.1.0",
    "pdfkit": "0.20.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pdfkit": "0.17.7",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
