{
  "name": "mechdost",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "db:generate": "pnpm --filter @mechdost/db generate",
    "db:migrate": "pnpm --filter @mechdost/db migrate",
    "db:seed": "pnpm --filter @mechdost/db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run typecheck lint test"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.0",
    "typescript": "~6.0.3",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.72.1"
  }
}
