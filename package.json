{
  "name": "mechdost",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "db:generate": "pnpm --filter @mechdost/db generate",
    "db:migrate": "pnpm --filter @mechdost/db migrate",
    "db:seed": "pnpm --filter @mechdost/db seed",
    "db:seed:demo": "pnpm --filter @mechdost/db seed:demo",
    "db:grant-role": "pnpm --filter @mechdost/db grant-role",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run typecheck lint test",
    "emulators": "pnpm dlx firebase-tools@15.35.0 emulators:start --only auth --project demo-mechdost"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "turbo": "^2.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
