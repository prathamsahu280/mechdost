{
  "name": "mechdost",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "db:generate": "pnpm --filter @mechdost/db generate",
    "db:migrate": "pnpm --filter @mechdost/db migrate",
    "db:seed": "pnpm --filter @mechdost/db seed",
    "db:seed:demo": "pnpm --filter @mechdost/db seed:demo",
    "db:seed:pincodes": "pnpm --filter @mechdost/db seed:pincodes",
    "db:seed:ustaad-starter": "pnpm --filter @mechdost/db seed:ustaad-starter",
    "db:grant-role": "pnpm --filter @mechdost/db grant-role",
    "db:ustaad:map-mechanic-applications": "pnpm --filter @mechdost/db ustaad:map-mechanic-applications",
    "wa:templates": "pnpm --filter @mechdost/api wa:templates",
    "usage:check": "pnpm --filter @mechdost/api usage:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run typecheck lint test --concurrency=1",
    "emulators": "pnpm dlx firebase-tools@15.35.0 emulators:start --only auth --project demo-mechdost",
    "db:import:catalogue": "pnpm --filter @mechdost/api import:catalogue",
    "db:import:exide": "pnpm --filter @mechdost/api import:exide",
    "db:import:amaron": "pnpm --filter @mechdost/api import:amaron",
    "db:import:tatagreen": "pnpm --filter @mechdost/api import:tatagreen",
    "db:import:ceat": "pnpm --filter @mechdost/api import:ceat",
    "db:import:mrf": "pnpm --filter @mechdost/api import:mrf",
    "db:import:apollo": "pnpm --filter @mechdost/api import:apollo",
    "db:import:hp": "pnpm --filter @mechdost/api import:hp",
    "db:import:bpcl": "pnpm --filter @mechdost/api import:bpcl",
    "db:import:servo": "pnpm --filter @mechdost/api import:servo"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
