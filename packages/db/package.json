{
  "name": "@mechdost/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./repo": "./src/repo/index.ts",
    "./crypto": "./src/crypto.ts",
    "./testing": "./src/testing.ts",
    "./demo-seed": "./src/demo-seed.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate && node scripts/fix-migrations.mjs",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "seed:demo": "tsx src/seed-demo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@mechdost/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@electric-sql/pglite-postgis": "0.2.12",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
