# MechDost environment variables — TEMPLATE ONLY. Never put real secrets in this file.
# Copy to `.env` in the repo root (git-ignored) and fill in values. One root .env is read by
# apps/web, apps/api and packages/db. Production values live in Vercel (web) and Google Secret Manager
# (API) — never in git. See docs/runbooks/setup.md for where to get each value.
#
# NEXT_PUBLIC_* values are shipped to the browser — only ever put PUBLIC keys there.

# ── App ────────────────────────────────────────────────────────────────────
# Production domain: mechdost.com (bought 2026-11-01). Production values: APP_URL / NEXT_PUBLIC_APP_URL =
# https://mechdost.com, API at https://api.mechdost.com, CORS_ORIGINS=https://mechdost.com,https://www.mechdost.com
# (www redirects to the apex). On Cloud Run (K_SERVICE set by the platform) the API refuses to start unless
# NODE_ENV=production, because development skips every production check.
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# API (apps/api): listen port; DB pool size per instance; proxies that append to X-Forwarded-For
# (0 locally, 1 behind the Cloud Run load balancer, 2 with Cloudflare in front; production refuses 0, which would
# put every user in one rate-limit bucket); OpenAPI docs at
# /openapi.json (default on outside production). Blank values count as unset.
PORT=4000
DATABASE_POOL_MAX=10
TRUSTED_PROXY_HOPS=0
API_DOCS=
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ── Supabase (database, storage, realtime) ───────────────────────────────────
# Dashboard → Connect → "Session pooler" (port 5432). Used for migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Dashboard → Connect → "Transaction pooler" (port 6543). Used by the API at runtime.
DATABASE_POOL_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Encryption in transit: TLS is always required for non-local databases. For full certificate checks
# (verify-full), download the CA certificate (Dashboard → Database → Settings → SSL) to a path OUTSIDE the repo.
# REQUIRED in production: with NODE_ENV=production the API refuses to start without it.
DATABASE_CA_CERT=

# ── Field encryption (SERVER ONLY; spec 13) ──────────────────────────────────
# AES-256-GCM keys for sensitive columns (*_enc: PAN, KYC, refund bank/UPI, staff 2FA secrets).
# Generate each key with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: add a new id ("k1:…,k2:…"), point DATA_ENCRYPTION_KEY_ID at it, keep old ids until re-encrypted.
# Production keys live in Google Secret Manager only; losing a key makes its data unreadable — back them up.
DATA_ENCRYPTION_KEYS=k1:<base64-32-byte-key>
DATA_ENCRYPTION_KEY_ID=k1
# Separate key for blind indexes (lookups such as "one shop per PAN" without decrypting).
DATA_INDEX_KEY=<base64-32-byte-key>

# Public (safe in browser). Project Settings → API Keys → Publishable key (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SECRET (server only). Project Settings → API Keys → Secret keys (sb_secret_…).
# The API also uses SUPABASE_URL + this key for job photos (private bucket `service-photos`, created by the API on start;
# docs/runbooks/photos.md). Unset or placeholder: photo routes answer 503 PHOTOS_UNAVAILABLE and everything else works.
# Never put this key in a NEXT_PUBLIC_ variable: pictures reach browsers only through the API.
SUPABASE_SECRET_KEY=
# ── Ustaad Network media (spec 23 § 10; Q-U1) ─────────────────────────────────────────────────────────────────
# `supabase` (default: Supabase Storage with SUPABASE_URL + SUPABASE_SECRET_KEY above) or `r2` (Cloudflare R2, needs
# every R2_* value; a missing one falls back to Supabase with a warning). Neither configured: uploads answer 503.
MEDIA_HOST=supabase
# The Supabase project's per-file upload limit in MB (free plan 50); video caps are clamped to it.
SUPABASE_MAX_UPLOAD_MB=50
# SECRET (server only). Cloudflare → R2 → Manage API tokens (Object Read & Write on the four buckets below).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_QUARANTINE=ustaad-quarantine
R2_BUCKET_MEDIA=ustaad-media
R2_BUCKET_DOCS=ustaad-docs
R2_BUCKET_EVIDENCE=ustaad-evidence
# Public hosts of the media and the (separate, cookieless) docs bucket.
R2_MEDIA_HOST=
R2_DOCS_HOST=
# ── Usage & limits (Admin → Usage & limits, `pnpm usage:check`; founder 2026-11-26; runbook monitoring.md) ──────
# Optional, SECRET (server only). A Cloudflare API token with "Account Analytics: Read" gives exact R2 Class A/B counts
# (GraphQL Analytics API). Empty = MechDost's own count of R2 calls, shown as "estimated".
CLOUDFLARE_ANALYTICS_TOKEN=
# Absolute path whose filesystem is the server disk measured by the check (default `/`).
USAGE_DISK_PATH=/
# Public (web CSP): the media upload/read origin(s), comma separated, https only, e.g. https://<account>.r2.cloudflarestorage.com
NEXT_PUBLIC_USTAAD_MEDIA_ORIGINS=
# Megabytes of public product photos kept in the API's memory so repeat views skip Supabase (default 64, 0 = off, max 128).
PHOTO_CACHE_MB=64

# ── Firebase Authentication (phone OTP) ──────────────────────────────────────
# Web sign-in (Q69): `firebase` = real accounts (needs the values below, the API and Turnstile keys);
# `demo` or empty = browser-only demo logins (code 123456) for partner demos.
NEXT_PUBLIC_AUTH_MODE=
# Storefront data (Q70): `api` = catalogue and search from NEXT_PUBLIC_API_URL (cart and checkout follow);
# `demo` or empty = built-in Raipur demo data. Keep `demo` on deploys until cart + checkout use the API too.
NEXT_PUBLIC_DATA_MODE=
# Tests only: cards per catalogue page in api mode (1–48, default 24).
CATALOGUE_PAGE_SIZE=
# Public web config: Firebase console → Project settings → Your apps → Web app → SDK config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web push (spec 10, Q103), public values: Firebase console → Project settings → Cloud Messaging → Web Push
# certificates (key pair) and the Sender ID. Until BOTH are set the "Turn on notifications" card stays hidden and the
# bell still works. Server side, push uses the same service account as the live updates (no new secret).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
# Same value as NEXT_PUBLIC_FIREBASE_API_KEY: the API checks passwords with it (POST /v1/auth/password, spec 01).
FIREBASE_API_KEY=
# Local dev uses the Auth Emulator (random SMS code, printed in its log and at /emulator/v1/projects/<id>/verificationCodes). Leave empty to use real Firebase.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Browser side of the emulator (firebase mode only); leave empty to use the real project.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
# Live updates (decision 2026-11-01): polling (default, no push) or rtdb (Firebase Realtime Database inbox pings,
# written by the worker `pnpm --filter @mechdost/api worker`). The RTDB lives in asia-southeast1 (no India region).
LIVE_TRANSPORT=polling
FIREBASE_DATABASE_URL=
# Browser side of the live updates: the same Realtime Database URL. Empty = the browser never connects and the pages just
# poll (cart and wishlist 60 s, bell 15/60 s); nothing breaks. Needs the rules in firebase/database.rules.json deployed.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# Server credentials: in production use Workload Identity (no file). Locally, point to a key file stored
# OUTSIDE the repo, e.g. C:\Users\<you>\secrets\mechdost-firebase-admin.json
GOOGLE_APPLICATION_CREDENTIALS=

# ── Upstash Redis (rate limits, cache) ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare Turnstile (bot protection on guest forms / OTP) ────────────────
# Development: Cloudflare's always-pass test keys (site 1x00000000000000000000AA, secret
# 1x0000000000000000000000000000000AA, https://developers.cloudflare.com/turnstile/troubleshooting/testing/).
# Production refuses to start without real ones (Q5).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── !!! TEMPORARY: Turnstile QA bypass (decision 2026-11-27, plan docs/qa/ustaad-simulation-plan-2026-11-27.md § 2.2) ──
# LEAVE ALL THREE EMPTY. Set only on the server's env file for a founder-approved QA run, then clear and redeploy.
# Off unless all three are set. The API REFUSES TO START if UNTIL is malformed or more than 12 h ahead; a past
# UNTIL means off. IDS = comma-separated HMAC-SHA256 hex of "user:<uuid>" / "phone:+91…" / "email:<lower-case>"
# keyed with KEY (>= 32 chars) — never raw phone numbers, emails or ids (runbook deploy.md "QA Turnstile bypass").
# Never in GitHub secrets, CI or NEXT_PUBLIC_*. Every use writes an audit_log row `security.turnstile_bypassed`.
QA_TURNSTILE_BYPASS_IDS=
QA_TURNSTILE_BYPASS_KEY=
QA_TURNSTILE_BYPASS_UNTIL=

# ── Maps (MapLibre tiles) ────────────────────────────────────────────────────
# MapTiler free tier key (public, restrict it to your domains in the MapTiler dashboard).
NEXT_PUBLIC_MAPTILER_KEY=

# Satellite imagery for the map's hybrid view (satellite + roads + names). PUBLIC tile URL template and its
# credit line. No major provider allows free commercial use (Esri needs an ArcGIS plan; MapTiler free is
# non-commercial), so production MUST set a licensed provider here (inbox Q27). Empty = Esri World Imagery for
# local demo only.
NEXT_PUBLIC_SATELLITE_TILES=
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=

# ── WhatsApp: Meta Cloud API directly (decision 2026-11-02; docs/research/whatsapp.md) ─────────────────────
# Requires the DATA_ENCRYPTION_* keys below (delivery codes are queued encrypted); the worker exits without them.
# Off until the Meta Business account, verified business, dedicated number and INR billing exist (Q50–Q63).
# Token = permanent System User token (Secret Manager in production). Webhook: https://api.mechdost.com/webhooks/whatsapp
WHATSAPP_ENABLED=off
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Template CLI only (`pnpm wa:templates`, docs/runbooks/whatsapp-templates.md; not read by the API or worker):
# the WhatsApp Business Account id (WhatsApp Manager → Business settings) and, optionally, a separate token with
# whatsapp_business_management; without it the CLI reuses WHATSAPP_ACCESS_TOKEN.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_MANAGEMENT_TOKEN=
# City used when a request names none: catalogue reads without ?city=, REQ-… codes of WhatsApp tickets from unknown senders.
DEFAULT_CITY_CODE=RPR

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Senders per purpose (decision 2026-11-13): updates@, billing@, support@ (also reply-to), promotions@, noreply@
# on EMAIL_DOMAIN. Verify the domain in Resend first (SPF, DKIM, DMARC; Q79).
EMAIL_DOMAIN=mechdost.com
# Website origin used for links in emails (https required in production). Also the base of the
# verification / password-reset links, which we send ourselves: {WEB_BASE_URL}/auth/action?mode=…&oobCode=… (2026-11-24).
WEB_BASE_URL=http://localhost:3000
# Grievance officer contact for the email footer (Q15b); the footer line stays hidden while this is empty.
EMAIL_GRIEVANCE_CONTACT=
# Fallback only: the grievance officer set in Admin -> Settings -> Company details wins when filled.
# Shared secret (32+ characters) with the website's /api/revalidate: after staff publish a policy, the home layout or
# company details the API asks the website to refresh its cache by tag. Set the SAME value in the web app's env.
# Empty = the website picks the change up within 60 seconds.
REVALIDATE_SECRET=
# Ustaad Network distance bands (spec 23 SR-29): a random 32+ character key for the per-pair noise. Keep it stable
# (a new key lets repeated reads average the noise away). Empty = Discover shows no distance bands.
USTAAD_LOCATION_SECRET=

# Ustaad Network share teasers (spec 23 § 10 step 7): HMAC key (≥ 32 characters) that signs the WhatsApp teaser
# links /ustaad/s/{token}. Empty = "Share" answers 503 SHARE_UNAVAILABLE. Changing it breaks old teaser links.
USTAAD_SHARE_SECRET=

# ── Payments (Razorpay Standard Checkout; docs/runbooks/payments.md) ──────────
# TEST keys (rzp_test_…) during the build; production refuses test keys. Online payment is offered only
# when the key id and secret are both set. The webhook route answers 404 until RAZORPAY_WEBHOOK_SECRET is set.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Pre-launch testing only: lets production start with rzp_test_ keys (fake payments). Remove before real customers.
RAZORPAY_ALLOW_TEST_KEYS=

# ── SMS / WhatsApp (MSG91) — later; off until set up ─────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_WHATSAPP_NUMBER=

# ── Analytics & monitoring (decision 2026-11-14; docs/runbooks/monitoring.md) — all off when empty ──
# PostHog EU cloud, server-side only: the worker forwards consented events from the event store. There is no
# browser key (no posthog-js). Project API key phc_… from PostHog → Project settings.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Sentry (EU region, de.sentry.io). API + worker DSN (project mechdost-api-actual):
SENTRY_DSN=
# production on the server; defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# Set by deploy/compose.yml from IMAGE_TAG (the deployed commit); leave empty locally.
SENTRY_RELEASE=
# Website DSN (project mechdost-api — the website project's slug), compiled into the browser code (build argument).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Set by the Deploy workflow to the commit; leave empty locally.
NEXT_PUBLIC_SENTRY_RELEASE=
# Source-map upload at Docker build time only (GitHub secret SENTRY_AUTH_TOKEN, variables SENTRY_ORG,
# SENTRY_PROJECT_WEB, SENTRY_URL). Org token with CI scope; never on the server.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=
SENTRY_URL=https://de.sentry.io
# Admin → Errors: a READ-ONLY token (Internal Integration: Issue & Event read, Project read, Organization read),
# never the CI token. With SENTRY_ORG and the project slugs; the panel says "not connected" until set.
SENTRY_API_TOKEN=
SENTRY_PROJECT_API=
SENTRY_REGION_URL=https://de.sentry.io

# ── Assistant (spec 18) — server only; the chat falls back to built-in answers when unset ──
# Anthropic key from console.anthropic.com. NEVER prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# The chat is OFF unless this is true, even with the key set (founder 2026-11-26: off for now; the key serves
# Ustaad smart correction). Cost: keep ASSISTANT_MODEL on a Haiku model when you turn it on.
ASSISTANT_ENABLED=false
# Optional model override (default claude-opus-5-5, with server-side fallbacks).
ASSISTANT_MODEL=

# ── Ustaad smart correction (spec 23 § 11, Q-U3) — server only ──
# none (default) = the word list on our server only; nothing leaves the server. anthropic = Claude (uses
# ANTHROPIC_API_KEY above); gemini = Google Gemini (GEMINI_API_KEY). Members' text is PII-masked before any call, and
# goes to the LLM only for members who gave the "smart correction" consent. Confirm the provider's data terms first.
SMART_CORRECTION_PROVIDER=
# Model id. Default for anthropic: claude-haiku-5-5 (a small, cheap Haiku-class model). Required for gemini.
SMART_CORRECTION_MODEL=
# Google AI Studio key, only for SMART_CORRECTION_PROVIDER=gemini. NEVER prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
