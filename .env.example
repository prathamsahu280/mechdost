# MechDost environment variables — TEMPLATE ONLY. Never put real secrets in this file.
# Copy to `.env` in the repo root (git-ignored) and fill in values. One root .env is read by
# apps/web, apps/api and packages/db. Production values live in Vercel (web) and Google Secret Manager
# (API) — never in git. See docs/runbooks/setup.md for where to get each value.
#
# NEXT_PUBLIC_* values are shipped to the browser — only ever put PUBLIC keys there.

# ── App ────────────────────────────────────────────────────────────────────
# Production domain: mechdost.com (bought 2026-11-01). Production values: APP_URL / NEXT_PUBLIC_APP_URL =
# https://mechdost.com, API at https://api.mechdost.com, CORS_ORIGINS=https://mechdost.com,https://www.mechdost.com
# (www redirects to the apex).
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# API (apps/api): listen port; DB pool size per instance; proxies that append to X-Forwarded-For
# (0 locally, 1 behind the Cloud Run load balancer, 2 with Cloudflare in front); OpenAPI docs at
# /openapi.json (default on outside production). Blank values count as unset.
PORT=4000
DATABASE_POOL_MAX=10
TRUSTED_PROXY_HOPS=0
API_DOCS=
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ── Supabase (database, storage, realtime) ───────────────────────────────────
# Dashboard → Connect → "Session pooler" (port 5432). Used for migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Dashboard → Connect → "Transaction pooler" (port 6543). Used by the API at runtime.
DATABASE_POOL_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Encryption in transit: TLS is always required for non-local databases. For full certificate checks
# (verify-full), download the CA certificate (Dashboard → Database → Settings → SSL) to a path OUTSIDE the repo.
# REQUIRED in production: with NODE_ENV=production the API refuses to start without it.
DATABASE_CA_CERT=

# ── Field encryption (SERVER ONLY; spec 13) ──────────────────────────────────
# AES-256-GCM keys for sensitive columns (*_enc: PAN, KYC, refund bank/UPI, staff 2FA secrets).
# Generate each key with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: add a new id ("k1:…,k2:…"), point DATA_ENCRYPTION_KEY_ID at it, keep old ids until re-encrypted.
# Production keys live in Google Secret Manager only; losing a key makes its data unreadable — back them up.
DATA_ENCRYPTION_KEYS=k1:<base64-32-byte-key>
DATA_ENCRYPTION_KEY_ID=k1
# Separate key for blind indexes (lookups such as "one shop per PAN" without decrypting).
DATA_INDEX_KEY=<base64-32-byte-key>

# Public (safe in browser). Project Settings → API Keys → Publishable key (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SECRET (server only). Project Settings → API Keys → Secret keys (sb_secret_…).
SUPABASE_SECRET_KEY=

# ── Firebase Authentication (phone OTP) ──────────────────────────────────────
# Public web config: Firebase console → Project settings → Your apps → Web app → SDK config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
# Local dev uses the Auth Emulator (test OTP 123456). Leave empty to use real Firebase.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Server credentials: in production use Workload Identity (no file). Locally, point to a key file stored
# OUTSIDE the repo, e.g. C:\Users\<you>\secrets\mechdost-firebase-admin.json
GOOGLE_APPLICATION_CREDENTIALS=

# ── Upstash Redis (rate limits, cache) ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare Turnstile (bot protection on guest forms / OTP) ────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Maps (MapLibre tiles) ────────────────────────────────────────────────────
# MapTiler free tier key (public, restrict it to your domains in the MapTiler dashboard).
NEXT_PUBLIC_MAPTILER_KEY=

# Satellite imagery for the map's hybrid view (satellite + roads + names). PUBLIC tile URL template and its
# credit line. No major provider allows free commercial use (Esri needs an ArcGIS plan; MapTiler free is
# non-commercial), so production MUST set a licensed provider here (inbox Q27). Empty = Esri World Imagery for
# local demo only.
NEXT_PUBLIC_SATELLITE_TILES=
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Production: MechDost <no-reply@mechdost.com> once the domain is verified in Resend (SPF, DKIM, DMARC).
EMAIL_FROM=MechDost <no-reply@example.com>

# ── Payments (Razorpay) — later; use TEST keys only during the build ──────────
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── SMS / WhatsApp (MSG91) — later; off until set up ─────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_WHATSAPP_NUMBER=

# ── Analytics & monitoring ───────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Assistant (spec 18) — server only; the chat falls back to built-in answers when unset ──
# Anthropic key from console.anthropic.com. NEVER prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5, with server-side fallbacks).
ASSISTANT_MODEL=
